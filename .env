EXPO_PUBLIC_BANK_BACKEND_URL=https://envelope-bank-backend.onrender.com

# ── RevenueCat (subscriptions) ────────────────────────────────────────────────
# These are PUBLIC SDK keys — safe to commit and ship inside the app.
# Get them from app.revenuecat.com → your project → API keys → "App specific".
# Leave them blank and the app simply reports that purchases aren't available.
#
# Purchases need a development build — they do NOT work inside Expo Go.
#
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxx
# EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=premium
