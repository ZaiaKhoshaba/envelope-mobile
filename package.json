{
  "name": "envelope-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "test": "node --test \"tests/budgetMath.test.mjs\"",
    "start:tunnel": "expo start --tunnel -c",
    "start:auto": "powershell -Command \"$ip = (Get-NetRoute -DestinationPrefix '0.0.0.0/0' | Sort-Object RouteMetric | Select-Object -First 1 | ForEach-Object { (Get-NetIPAddress -InterfaceIndex $_.InterfaceIndex -AddressFamily IPv4 | Where-Object { $_.IPAddress -notlike '169.254*' } | Select-Object -First 1).IPAddress }); $env:REACT_NATIVE_PACKAGER_HOSTNAME = $ip; $env:EXPO_PUBLIC_BANK_BACKEND_URL = 'http://' + $ip + ':4000'; Write-Host ('Using packager host: ' + $env:REACT_NATIVE_PACKAGER_HOSTNAME); Write-Host ('Using backend: ' + $env:EXPO_PUBLIC_BANK_BACKEND_URL); npx expo start --lan -c\"",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:lan": "expo start --host lan",
    "clean": "node -e \"try{require('fs').rmSync('node_modules',{recursive:true,force:true});require('fs').rmSync('.expo',{recursive:true,force:true});require('fs').rmSync('.cache',{recursive:true,force:true});require('fs').rmSync('package-lock.json',{force:true});}catch(e){}\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "^54.0.12",
    "expo-auth-session": "^7.0.8",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.20",
    "expo-haptics": "~15.0.8",
    "expo-keep-awake": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.10",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.1.10",
    "@types/react-native": "^0.72.8",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "metro": "0.83.3",
    "metro-babel-transformer": "0.83.3",
    "metro-cache": "0.83.3",
    "metro-cache-key": "0.83.3",
    "metro-config": "0.83.3",
    "metro-core": "0.83.3",
    "metro-file-map": "0.83.3",
    "metro-minify-terser": "0.83.3",
    "metro-resolver": "0.83.3",
    "metro-runtime": "0.83.3",
    "metro-source-map": "0.83.3",
    "metro-symbolicate": "0.83.3",
    "metro-transform-plugins": "0.83.3",
    "metro-transform-worker": "0.83.3"
  }
}
